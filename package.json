{
  "name": "pharmaxpress",
  "version": "1.0.0",
  "description": "PharmaXpress — High-Velocity Pharmacy Workflow Engine untuk RS Indriati Boyolali",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "seed": "node server/seed.js",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^8.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@ngrok/ngrok": "^1.7.0",
    "fastify": "^5.0.0",
    "fuse.js": "^7.0.0",
    "lucide-react": "^1.37.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^1.7.0",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
